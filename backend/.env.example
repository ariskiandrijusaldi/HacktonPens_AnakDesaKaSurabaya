# ==== Aplikasi ====
APP_NAME=Agen Satgas PPKS Kampus
ENVIRONMENT=development
DEBUG=false

# ==== Database ====
# Default SQLite. Ganti ke Postgres/Supabase cukup ubah baris ini.
# Contoh: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./ppks.db

# ==== Kunci Keamanan (WAJIB diisi) ====
# Generate dengan: python generate_keys.py
# ENCRYPTION_KEY = kunci Fernet untuk enkripsi data sensitif (teks asli & kontak)
ENCRYPTION_KEY=
# HMAC_KEY = kunci rahasia untuk hash nama terlapor (anti-enumerasi pola)
HMAC_KEY=
# JWT_SECRET = kunci penandatangan token petugas
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==== Emergency Override (buka identitas korban) ====
# Isi salah satu. OVERRIDE_PIN_HASH (bcrypt) lebih disarankan; jika kosong,
# OVERRIDE_PIN akan di-hash otomatis saat startup.
OVERRIDE_PIN=
OVERRIDE_PIN_HASH=
OVERRIDE_MAX_ATTEMPTS=3
OVERRIDE_LOCKOUT_MINUTES=15

# ==== Gemini AI ====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20

# ==== Telegram Notifier (opsional) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=http://localhost:5173

# ==== CORS ====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==== Rate limit (format slowapi: "<jumlah>/<periode>"; in-memory, IP tak disimpan) ====
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REPORT=10/minute
RATE_LIMIT_TICKET=10/minute
RATE_LIMIT_MESSAGE=10/minute

# ==== Lampiran ====
UPLOAD_DIR=./storage/attachments
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_REPORT=3

# ==== Seed Petugas (dibuat saat startup jika tabel Officer kosong) ====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
MEMBER_USERNAME=anggota
MEMBER_PASSWORD=
